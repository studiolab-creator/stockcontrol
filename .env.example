# Pooled connection — used by Prisma Client at runtime (Neon PgBouncer URL)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct connection — used by prisma db push / prisma migrate dev
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# JWT signing secret — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-random-32-byte-base64-string"
